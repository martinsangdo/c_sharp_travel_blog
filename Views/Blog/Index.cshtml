@model TravelBlog.ViewModels.BlogListViewModel
@{
    ViewData["Title"] = "Explore Blogs";
}

<div class="tb-page-header">
    <div class="container">
        <h1 class="tb-page-title">Explore Travel Stories</h1>
        <p class="tb-page-sub">@Model.TotalCount blog posts from travelers around the world</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="tb-sidebar">
                <!-- Search -->
                <div class="tb-sidebar-section">
                    <h6 class="tb-sidebar-title">Search</h6>
                    <form asp-action="Index" method="get">
                        <input type="hidden" name="destination" value="@Model.Destination" />
                        <input type="hidden" name="sortBy" value="@Model.SortBy" />
                        <div class="input-group">
                            <input type="text" name="search" value="@Model.SearchQuery"
                                   class="form-control tb-search-input" placeholder="Search blogs..." />
                            <button class="btn btn-tb" type="submit"><i class="fa fa-search"></i></button>
                        </div>
                    </form>
                </div>

                <!-- Sort -->
                <div class="tb-sidebar-section">
                    <h6 class="tb-sidebar-title">Sort By</h6>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var (key, label, icon) in new[] { ("newest", "Newest First", "fa-clock"), ("views", "Most Viewed", "fa-eye"), ("comments", "Most Commented", "fa-comment") })
                        {
                            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-destination="@Model.Destination" asp-route-sortBy="@key"
                               class="tb-sort-link @(Model.SortBy == key ? "active" : "")">
                                <i class="fa @icon me-2"></i>@label
                            </a>
                        }
                    </div>
                </div>

                <!-- Destinations -->
                @if (Model.PopularDestinations.Any())
                {
                    <div class="tb-sidebar-section">
                        <h6 class="tb-sidebar-title">Destinations</h6>
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-sortBy="@Model.SortBy"
                               class="tb-dest-pill btn btn-sm @(string.IsNullOrEmpty(Model.Destination) ? "active" : "")">All</a>
                            @foreach (var dest in Model.PopularDestinations)
                            {
                                <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-destination="@dest" asp-route-sortBy="@Model.SortBy"
                                   class="tb-dest-pill btn btn-sm @(Model.Destination == dest ? "active" : "")">@dest</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Blog Grid -->
        <div class="col-lg-9">
            @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.Destination))
            {
                <div class="tb-filter-bar mb-3">
                    <span class="text-muted small">
                        @Model.TotalCount result@(Model.TotalCount != 1 ? "s" : "")
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        { <text> for "<strong>@Model.SearchQuery</strong>"</text> }
                        @if (!string.IsNullOrEmpty(Model.Destination))
                        { <text> in <strong>@Model.Destination</strong></text> }
                    </span>
                    <a asp-action="Index" class="btn btn-sm tb-clear-filter ms-2">
                        <i class="fa fa-xmark me-1"></i>Clear filters
                    </a>
                </div>
            }

            @if (Model.Blogs.Any())
            {
                <div class="row g-4">
                    @foreach (var blog in Model.Blogs)
                    {
                        <div class="col-md-6 col-xl-4">
                            <partial name="_BlogCard" model="blog" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination tb-pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage-1)"
                                   asp-route-search="@Model.SearchQuery" asp-route-destination="@Model.Destination"
                                   asp-route-sortBy="@Model.SortBy">
                                    <i class="fa fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                                       asp-route-search="@Model.SearchQuery" asp-route-destination="@Model.Destination"
                                       asp-route-sortBy="@Model.SortBy">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage+1)"
                                   asp-route-search="@Model.SearchQuery" asp-route-destination="@Model.Destination"
                                   asp-route-sortBy="@Model.SortBy">
                                    <i class="fa fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="tb-empty-state text-center py-5">
                    <i class="fa fa-compass fa-3x mb-3"></i>
                    <h5>No blogs found</h5>
                    <p class="text-muted">Try adjusting your search or be the first to write about this destination!</p>
                    <a asp-controller="Blog" asp-action="Create" class="btn btn-tb">
                        <i class="fa fa-pen me-2"></i>Write a Blog
                    </a>
                </div>
            }
        </div>
    </div>
</div>
