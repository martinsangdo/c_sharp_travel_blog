@{
    ViewData["Title"] = "Manage Users";
    var users = ViewBag.Users as List<TravelBlog.ViewModels.UserSummaryViewModel> ?? new();
    var currentUserId = Context.Session.GetInt32("UserId");
}

<div class="tb-admin-layout">
    <aside class="tb-admin-sidebar">
        <div class="tb-admin-brand"><i class="fa fa-shield-halved me-2"></i>Admin Panel</div>
        <nav class="tb-admin-nav">
            <a class="tb-admin-nav-item" asp-action="Index"><i class="fa fa-chart-line"></i>Dashboard</a>
            <a class="tb-admin-nav-item active" asp-action="Users"><i class="fa fa-users"></i>Users</a>
            <a class="tb-admin-nav-item" asp-action="Blogs"><i class="fa fa-newspaper"></i>Blog Posts</a>
            <a class="tb-admin-nav-item" asp-action="CreateAdmin"><i class="fa fa-user-shield"></i>Add Admin</a>
            <hr /><a class="tb-admin-nav-item" asp-controller="Home" asp-action="Index"><i class="fa fa-arrow-left"></i>Back to Site</a>
        </nav>
    </aside>
    <main class="tb-admin-content">
        <div class="tb-admin-topbar">
            <h4 class="mb-0 fw-bold">Users <span class="badge bg-secondary">@ViewBag.TotalCount</span></h4>
            <a asp-action="CreateAdmin" class="btn btn-tb btn-sm"><i class="fa fa-plus me-1"></i>Add Admin</a>
        </div>

        <!-- Search -->
        <form asp-action="Users" method="get" class="mb-4">
            <div class="input-group" style="max-width:360px">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control tb-input" placeholder="Search users..." />
                <button class="btn btn-tb"><i class="fa fa-search"></i></button>
            </div>
        </form>

        <div class="tb-admin-card">
            <div class="table-responsive">
                <table class="table tb-admin-table align-middle">
                    <thead>
                        <tr>
                            <th>User</th><th>Email</th><th>Role</th><th>Blogs</th><th>Joined</th><th>Status</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr class="@(!u.IsActive ? "table-secondary opacity-75" : "")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="tb-avatar-placeholder-xs">@u.Username[0]</span>
                                        <div>
                                            <div class="fw-semibold small">@u.FullName</div>
                                            <div class="text-muted x-small">@@@u.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small text-muted">@u.Email</td>
                                <td>
                                    <span class="badge @(u.Role == TravelBlog.Models.UserRole.Admin ? "bg-danger" : "bg-primary")">@u.Role</span>
                                </td>
                                <td class="text-center">@u.BlogCount</td>
                                <td class="small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td>
                                    @if (u.IsActive)
                                    { <span class="badge bg-success">Active</span> }
                                    else
                                    { <span class="badge bg-secondary">Inactive</span> }
                                </td>
                                <td>
                                    @if (u.Id == currentUserId)
                                    {
                                        <span class="text-muted small">You</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-1">
                                            <form asp-action="ToggleUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                        onclick="return confirm('@(u.IsActive ? "Deactivate" : "Activate") this user?')">
                                                    @(u.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Permanently delete this user? This cannot be undone.')">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination tb-pagination justify-content-center">
                    @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Users" asp-route-page="@p" asp-route-search="@ViewBag.Search">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </main>
</div>
