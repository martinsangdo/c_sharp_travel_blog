@{
    ViewData["Title"] = "TravelBlog – Share Your Adventures";
    var featured = ViewBag.FeaturedBlogs as List<TravelBlog.ViewModels.BlogCardViewModel> ?? new();
    var latest = ViewBag.LatestBlogs as List<TravelBlog.ViewModels.BlogCardViewModel> ?? new();
    var destinations = ViewBag.PopularDestinations as List<string> ?? new();
}

<!-- Hero -->
<section class="tb-hero">
    <div class="tb-hero-overlay"></div>
    <div class="container position-relative z-1">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="tb-hero-eyebrow">✈️ Stories from around the world</p>
                <h1 class="tb-hero-title">Every Journey<br>Deserves to be Told</h1>
                <p class="tb-hero-sub">Discover real travel stories, hidden gems, and insider tips from travelers just like you.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Blog" asp-action="Index" class="btn btn-tb btn-lg">
                        <i class="fa fa-compass me-2"></i>Explore Blogs
                    </a>
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <a asp-controller="Blog" asp-action="Create" class="btn btn-tb-outline btn-lg">
                            <i class="fa fa-pen me-2"></i>Write a Story
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-tb-outline btn-lg">
                            <i class="fa fa-user-plus me-2"></i>Join Free
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Destinations -->
@if (destinations.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="tb-section-title">Popular Destinations</h2>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @foreach (var dest in destinations)
                {
                    <a asp-controller="Blog" asp-action="Index" asp-route-destination="@dest"
                       class="btn btn-sm tb-dest-pill">
                        <i class="fa fa-location-dot me-1"></i>@dest
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Blogs -->
@if (featured.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="tb-section-title mb-0">Most Visited</h2>
                <a asp-controller="Blog" asp-action="Index" asp-route-sortBy="views" class="tb-link-arrow">
                    View all <i class="fa fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="row g-4">
                @foreach (var blog in featured.Take(3))
                {
                    <div class="col-md-4">
                        <partial name="_BlogCard" model="blog" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Latest Blogs -->
@if (latest.Any())
{
    <section class="py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="tb-section-title mb-0">Fresh Stories</h2>
                <a asp-controller="Blog" asp-action="Index" class="tb-link-arrow">
                    View all <i class="fa fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="row g-4">
                @foreach (var blog in latest)
                {
                    <div class="col-md-4">
                        <partial name="_BlogCard" model="blog" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- CTA -->
@if (!Context.Session.GetInt32("UserId").HasValue)
{
    <section class="tb-cta-section py-5">
        <div class="container text-center">
            <i class="fa fa-earth-asia fa-3x mb-3 text-accent"></i>
            <h2 class="tb-section-title">Ready to Share Your Story?</h2>
            <p class="text-muted mb-4">Join thousands of travel writers. Use our AI assistant to find ideas and get started.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-tb btn-lg">
                <i class="fa fa-user-plus me-2"></i>Create Free Account
            </a>
        </div>
    </section>
}
